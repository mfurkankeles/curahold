    "create_task": {
      "label": "Create task",
      "description": "Opens a task on a board.",
      "type": "action",
      "connection": "apikey",
      "api": {
        "url": "/tasks",
        "method": "POST",
        "body": "{{parameters}}",
        "response": {
          "output": "{{body.task}}"
        }
      },
      "parameters": [
        {
          "name": "boardId",
          "label": "Board",
          "required": true,
          "type": "select",
          "options": "rpc://list_boards"
        },
        {
          "name": "title",
          "label": "Title",
          "required": true,
          "type": "text"
        },
        {
          "name": "description",
          "label": "Description",
          "required": false,
          "type": "text",
          "multiline": true
        },
        {
          "name": "assigneeIds",
          "label": "Assignees",
          "required": false,
          "type": "select",
          "options": "rpc://list_people",
          "multiple": true
        },
        {
          "name": "accountId",
          "label": "Customer",
          "required": false,
          "type": "select",
          "options": "rpc://list_accounts"
        },
        {
          "name": "dueDate",
          "label": "Due date",
          "required": false,
          "type": "text",
          "help": "YYYY-MM-DD"
        },
        {
          "name": "priority",
          "label": "Priority",
          "required": false,
          "type": "select",
          "options": [
            {
              "label": "low",
              "value": "low"
            },
            {
              "label": "normal",
              "value": "normal"
            },
            {
              "label": "high",
              "value": "high"
            },
            {
              "label": "urgent",
              "value": "urgent"
            }
          ]
        }
      ],
      "interface": [
        {
          "name": "id",
          "type": "text",
          "label": "id"
        },
        {
          "name": "title",
          "type": "text",
          "label": "title"
        },
        {
          "name": "status",
          "type": "text",
          "label": "status"
        },
        {
          "name": "done",
          "type": "boolean",
          "label": "done"
        },
        {
          "name": "priority",
          "type": "text",
          "label": "priority"
        },
        {
          "name": "dueDate",
          "type": "text",
          "label": "dueDate"
        },
        {
          "name": "accountId",
          "type": "text",
          "label": "accountId"
        },
        {
          "name": "accountName",
          "type": "text",
          "label": "accountName"
        },
        {
          "name": "assigneeIds",
          "type": "array",
          "label": "assigneeIds"
        }
      ],
      "samples": {
        "id": "6f1c2f0e-1b7a-4c53-9b61-0f2d6a3c9e11",
        "title": "Send the renewal proposal",
        "status": "todo",
        "done": false,
