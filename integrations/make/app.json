{
  "name": "curahold",
  "label": "Curahold",
  "description": "Customers, tasks and timelines in Curahold: start scenarios from what happens there, and add or change things.",
  "language": "en",
  "base": {
    "baseUrl": "https://{{connection.domain}}/api",
    "headers": {
      "authorization": "Bearer {{connection.apiKey}}"
    },
    "response": {
      "error": {
        "message": "[{{statusCode}}] {{body.message}}"
      }
    },
    "log": {
      "sanitize": [
        "request.headers.authorization"
      ]
    }
  },
  "connections": {
    "apikey": {
      "label": "Curahold API key",
      "type": "basic",
      "parameters": [
        {
          "name": "domain",
          "label": "Curahold address",
          "type": "text",
          "required": true,
          "help": "The address you open Curahold at, for example yourcompany.curahold.com (no https://)."
        },
        {
          "name": "apiKey",
          "label": "API key",
          "type": "password",
          "required": true,
          "help": "In Curahold: Your settings → API keys and connected apps → New API key."
        }
      ],
      "api": {
        "url": "https://{{parameters.domain}}/api/me",
        "headers": {
          "authorization": "Bearer {{parameters.apiKey}}"
        },
        "response": {
          "metadata": {
            "type": "text",
            "value": "{{body.org.name}}"
          },
          "error": {
            "message": "[{{statusCode}}] {{body.message}}"
          }
        },
        "log": {
          "sanitize": [
            "request.headers.authorization"
          ]
        }
      }
    }
  },
  "webhooks": {
    "task_created": {
      "label": "New task",
      "type": "web",
      "connection": "apikey",
      "api": {
        "output": "{{body.data}}"
      },
      "attach": {
        "url": "/dev/webhooks",
        "method": "POST",
        "body": {
          "url": "{{webhook.url}}",
          "events": [
            "task.created"
          ]
        },
        "response": {
          "data": {
            "externalHookId": "{{body.webhook.id}}"
          }
        }
      },
      "detach": {
        "url": "/dev/webhooks/{{webhook.externalHookId}}",
        "method": "DELETE"
      }
    },
    "task_updated": {
      "label": "Task changed",
      "type": "web",
      "connection": "apikey",
      "api": {
        "output": "{{body.data}}"
      },
      "attach": {
        "url": "/dev/webhooks",
        "method": "POST",
        "body": {
          "url": "{{webhook.url}}",
          "events": [
            "task.updated"
          ]
        },
        "response": {
          "data": {
            "externalHookId": "{{body.webhook.id}}"
          }
        }
      },
      "detach": {
        "url": "/dev/webhooks/{{webhook.externalHookId}}",
        "method": "DELETE"
      }
    },
    "task_done": {
      "label": "Task completed",
      "type": "web",
      "connection": "apikey",
      "api": {
        "output": "{{body.data}}",
        "condition": "{{body.data.done}}"
      },
      "attach": {
        "url": "/dev/webhooks",
        "method": "POST",
        "body": {
          "url": "{{webhook.url}}",
          "events": [
            "task.updated"
          ]
        },
        "response": {
          "data": {
            "externalHookId": "{{body.webhook.id}}"
