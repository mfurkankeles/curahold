    "update_task": {
      "label": "Update task",
      "description": "Changes a task: its title, column, date or priority.",
      "type": "action",
      "connection": "apikey",
      "api": [
        {
          "url": "/tasks/{{parameters.taskId}}",
          "method": "GET",
          "response": {
            "temp": {
              "baseVersion": "{{body.task.version}}"
            }
          }
        },
        {
          "url": "/tasks/{{parameters.taskId}}",
          "method": "PATCH",
          "body": {
            "baseVersion": "{{temp.baseVersion}}",
            "title": "{{parameters.title}}",
            "description": "{{parameters.description}}",
            "status": "{{parameters.status}}",
