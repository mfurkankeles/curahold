{
  "name": "curahold",
  "version": "0.1.0",
  "description": "Curahold — work management for customer success and account teams, with the chat apps and CRMs they already use",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build && vite build --config vite.portal.config.ts && tsx scripts/build-docs.ts",
    "start:local": "SERVE_STATIC=1 tsx api/src/node.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && tsx tests/e2e/run.ts && tsx tests/e2e/docs.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "strings": "tsx scripts/add-strings.ts",
    "migrate": "tsx scripts/migrate.ts",
    "docs:reference": "tsx scripts/docs/api-reference.ts",
    "build:demo": "vite build --config vite.demo.config.ts && tsx scripts/build-docs.ts dist/demo/docs --relative && tsx scripts/build-demo-hub.ts",
    "test:demo": "npm run build:demo && tsx tests/e2e/demo.ts && tsx tests/e2e/tours.ts",
    "build:site": "tsx scripts/build-site.ts",
    "build:server": "tsx scripts/build-server.ts",
    "start:selfhost": "node dist/server/selfhost.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:isolation": "vitest run tests/isolation.test.ts tests/isolation-routes.test.ts tests/rls.test.ts",
    "test:leak": "vitest run tests/leak.test.ts",
    "test:i18n": "vitest run tests/i18n.test.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "nodemailer": "^10.5.0",
    "postal-mime": "^4.2.1",
    "postgres": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrweb": "^2.2.2",
    "rrweb-player": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/parser": "^8.1.0",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "marked": "^18.2.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
