{
  "name": "tendwell",
  "version": "0.1.0",
  "description": "Tendwell — work management for customer success and account teams, with the chat apps and CRMs they already use",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build && vite build --config vite.portal.config.ts && tsx scripts/build-docs.ts",
    "start:local": "SERVE_STATIC=1 tsx api/src/node.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && tsx tests/e2e/run.ts && tsx tests/e2e/docs.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test:demo": "npm run build:demo && tsx tests/e2e/demo.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "marked": "^18.2.0",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
