{
  "name": "tendwell",
  "version": "0.1.0",
  "description": "Tendwell — Slack-native work management for customer success and account teams",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build",
    "start:local": "SERVE_STATIC=1 tsx api/src/node.ts",
    "test": "vitest run",
    "test:e2e": "vite build && tsx tests/e2e/run.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
