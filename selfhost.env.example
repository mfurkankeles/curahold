# Curahold on your own server: copy this file to .env and fill it in.
# Never commit .env; it holds secrets.

# The address people open, exactly as in the browser (HTTPS in front of the app).
PUBLIC_URL=https://curahold.example.com

# 32 or more random characters, e.g. the output of: openssl rand -base64 48
AUTH_SECRET=

# The database password for docker-compose.yml (letters and digits only).
DB_PASSWORD=

# Your company, created on the first start, and its first administrator, who
# signs in with an emailed link.
COMPANY_NAME=Our company
ADMIN_EMAIL=you@example.com
ADMIN_NAME=
# en or tr
LOCALE=en
TIMEZONE=Europe/Istanbul
CURRENCY=USD

# Mail: sign-in links, reminders, summaries. Without SMTP_URL the mails are
# written to the app's log (docker compose logs app), handy for the very first
# sign-in, not for daily use.
# SMTP_URL=smtp://user:password@mail.example.com:587
# EMAIL_FROM=Curahold <curahold@example.com>

# Optional: Google and Microsoft sign-in, chat apps and CRMs, with the same
# names as in the README (GOOGLE_CLIENT_ID, SLACK_CLIENT_ID, SALESFORCE_CLIENT_ID…).
# Optional: the customer portal on its own address, e.g. portal.example.com.
# PORTAL_DOMAIN=
