{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-basicauth",
          "options": {
            "allows": [
              "/postgres:\\/\\/postgres:postgres@127\\.0\\.0\\.1/",
              "/user:password@mail\\.example\\.com/",
              "/kullanici:parola@mail\\.ornek\\.com/",
              "/:\\/\\/user:pw@/"
            ]
          }
        },
        { "id": "@secretlint/secretlint-rule-privatekey", "options": { "allows": ["/-----BEGIN PRIVATE KEY-----\\\\n(\\$\\{|…)/"] } },
        { "id": "@secretlint/secretlint-rule-slack", "options": { "allows": ["xoxb-secret-token"] } }
      ]
    }
  ]
}
